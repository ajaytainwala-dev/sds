# ==============================================================================
# SRIDHAR DRIVING SCHOOL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public website base URL (used for canonical URLs, OpenGraph, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://sridhardrivingschool.in

# School phone number for direct click-to-call links
NEXT_PUBLIC_PHONE_NUMBER="+91 98450 12345"

# School WhatsApp number for wa.me click-to-chat links (format: country code without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919845012345

# Email address of the driving school owner/office where website enquiries will be delivered
OWNER_EMAIL=admissions@sridhardrivingschool.in

# Resend API Key for sending admission enquiry notification emails (from https://resend.com)
# In development or staging without a key, the system logs and simulates dispatch safely.
RESEND_API_KEY=re_placeholder

# Sender address configured in Resend (e.g. notifications@yourdomain.com or onboarding@resend.dev during testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# (Optional) WhatsApp Cloud API settings for automated owner notifications if enabled by business
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
